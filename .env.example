# Copy this file to .env for Docker Compose, or set the same variables in your shell.
ANTHROPIC_API_KEY=
# MongoDB Atlas AI / Voyage API key, separate from the Anthropic key.
VOYAGE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_TIMEOUT_SECONDS=60
# Includes reasoning and final output tokens for each model call.
CLAUDE_MAX_TOKENS=2048
MAX_TOOL_CALLS=6
STORE_TIMEZONE=America/Campo_Grande

# Models and endpoints never switch automatically after a request fails.
# Match model, dimensions, tokenizer and chunk limits when changing the embedding profile.
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_BASE_URL=https://ai.mongodb.com/v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
# Set these to the request/token limits for your account; defaults target the trial tier.
EMBEDDING_REQUESTS_PER_MINUTE=3
EMBEDDING_TOKENS_PER_MINUTE=10000
EMBEDDING_BATCH_TOKENS=8000
# Blank fields use voyageai/voyage-4-lite with pinned revision
# 0335ddf7698395712e3220733b4079006951cfef. No model weights or HF credentials are needed.
# A custom tokenizer repository must provide a compatible tokenizer.json.
EMBEDDING_TOKENIZER_MODEL=
EMBEDDING_TOKENIZER_REVISION=
# Set the maximum below the model input window, allowing prefixes and special tokens.
# Use 0 <= overlap < target <= maximum. Smaller-context models need smaller chunks.
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80

# Host input folder for Compose; mounted read-only at /app/data inside the container.
DATA_DIR=data
# Used for local uv execution; Compose always uses its persistent /app/runtime volume.
RUNTIME_DIR=runtime
# Host port only; Streamlit and the container health check keep using internal port 8501.
APP_PORT=8501
