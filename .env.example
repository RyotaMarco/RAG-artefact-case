# Copy this file to .env for Docker Compose, or set the same variables in your shell.
ANTHROPIC_API_KEY=
HF_TOKEN=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_SECONDS=60
CLAUDE_MAX_TOKENS=1024
MAX_TOOL_CALLS=6
STORE_TIMEZONE=America/Campo_Grande

# Change the model, matching dimensions, query/document prefixes and tokenizer revision together.
# Models and providers never switch automatically after a request fails.
# The model must support feature extraction; its tokenizer repository needs tokenizer.json.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_PROVIDER=deepinfra
EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=30
# Literal \n becomes a newline. Set a prefix to empty for a model that expects plain text.
EMBEDDING_QUERY_PREFIX=Instruct: Given a question about store policies, retrieve relevant passages that answer it.\nQuery:
EMBEDDING_DOCUMENT_PREFIX=
# Blank tokenizer fields select the embedding model and its pinned Qwen revision, otherwise main.
EMBEDDING_TOKENIZER_MODEL=
EMBEDDING_TOKENIZER_REVISION=
# Set the maximum below the model input window, allowing prefixes and special tokens.
# Use 0 <= overlap < target <= maximum. Smaller-context models need smaller chunks.
CHUNK_TARGET_TOKENS=600
CHUNK_MAX_TOKENS=800
CHUNK_OVERLAP_TOKENS=80

# Host input folder for Compose; mounted read-only at /app/data inside the container.
DATA_DIR=data
# Used for local uv execution; Compose always uses its persistent /app/runtime volume.
RUNTIME_DIR=runtime
# Host port only; Streamlit and the container health check keep using internal port 8501.
APP_PORT=8501
